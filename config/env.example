# ============================================================
# AI / 具身智能资讯雷达 —— 环境变量（机密，勿提交 git）
# 填写位置：复制本文件为 app/Horizon/.env 后填写
# 填写完成后按 doc/todo.md 步骤 1.3 做一次连通性验证
# ============================================================

# --- 必填 1：中转站 API Key ---
OPENAI_API_KEY=

# --- 必填 2：中转站地址（OpenAI 兼容接口，通常以 /v1 结尾，如 https://xxx.example.com/v1）---
OPENAI_BASE_URL=

# --- 必填 3：模型名（data/config.json 中以 ${HORIZON_MODEL} 引用）---
HORIZON_MODEL=

# --- 可选：本机代理（访问被墙源时需要：Google News / HuggingFace；
#     HN、TLDR、机器之心官网可直连，无需代理）---
# HTTPS_PROXY=http://127.0.0.1:7897
# HTTP_PROXY=http://127.0.0.1:7897
# NO_PROXY=localhost,127.0.0.1

# --- 第 4 阶段邮件推送时再填（QQ 邮箱网页端开启 SMTP 后生成授权码，不是 QQ 密码）---
# EMAIL_PASSWORD=

# --- radar Web 门户访客口令（管理员口令在 deploy/radar-web.service 的 RADAR_ACCESS_KEY）---
# RADAR_GUEST_KEY=

# --- B16 可选：备用 API（主 API 限额/不可用时自动切换；两项都填才启用）---
BACKUP_OPENAI_API_KEY=
BACKUP_OPENAI_BASE_URL=
# 备用端点模型名（与主端点不同时填写；留空沿用 HORIZON_MODEL）
# BACKUP_HORIZON_MODEL=
